# Variables de docker-compose. Copiar a .env (NUNCA commitearlo) y completar.

POSTGRES_DB=pinateria_demo
POSTGRES_USER=postgres
# Sin caracteres @ : / # en la contraseña (van dentro de una URL).
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE

# Clave que firma los tokens de sesión. Generar una nueva con:
#   openssl rand -base64 48
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA

# Token del túnel (Cloudflare Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=CAMBIAR_POR_EL_TOKEN_DEL_TUNEL
