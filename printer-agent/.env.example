# Copiar a .env en el equipo POS. Todas las variables son opcionales.

# mock = no imprime, guarda el ticket en tickets_mock/ (desarrollo, sin impresora)
# escpos = imprime en la Epson TM-T20II
AGENTE_MODO=mock

# Solo escuchar en el propio equipo. No cambiar.
AGENTE_HOST=127.0.0.1
AGENTE_PUERTO=9100

# Origenes web autorizados (separados por comas): el POS en desarrollo y,
# en produccion, el dominio publico del sistema (Cloudflare Tunnel). En el PC del
# POS: AGENTE_ORIGENES_PERMITIDOS=https://pos.demo.example.com,http://localhost:5173
# (sin el dominio, el navegador bloquea al agente y los tickets no se imprimen).
AGENTE_ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Encabezado del ticket, en 4 lineas (deja una vacia para omitirla).
AGENTE_NOMBRE_NEGOCIO=PIÑATERIA DEMO
AGENTE_NIT_NEGOCIO=NIT: 900.000.000 - 0
AGENTE_DIRECCION_NEGOCIO=CALLE 123 # 45-67 BARRIO DEMO
AGENTE_TELEFONO_NEGOCIO=Tel: 3000000000
AGENTE_PIE_TICKET=¡Gracias por tu compra!

# Logo en blanco y negro que se imprime arriba del ticket (relativo a la carpeta del agente).
# Vacio = sin logo. Si el archivo falta o falla, el ticket sale igual, sin logo.
# Para cambiarlo: python tools/generar_logo.py <logo a color.png> assets/logo-ticket.png
AGENTE_LOGO_TICKET=assets/logo-ticket.png

# Caracteres por linea (48 en papel de 80 mm; bajar a 42 si el texto se corta).
AGENTE_ANCHO_COLUMNAS=48

# Windows: nombre EXACTO de la impresora en "Impresoras y escaneres". Si se
# define, se imprime por el spooler de Windows. Si se deja vacio, se usa USB
# directo (requiere libusb/driver WinUSB, ver README).
# AGENTE_IMPRESORA_WINDOWS=EPSON TM-T20II Receipt
