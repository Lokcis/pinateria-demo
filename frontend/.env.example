# Copiar a .env.local para desarrollo, o .env.production para el build de la tienda.

# URL del backend FastAPI (servidor de Bogota, via Cloudflare Tunnel en produccion).
VITE_API_BASE_URL=http://localhost:8000

# URL del agente de impresion local, SIEMPRE localhost del equipo POS (nunca
# la URL publica del backend): ver printer-agent/README.md.
VITE_PRINTER_AGENT_URL=http://127.0.0.1:9100
